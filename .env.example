PORT=3000
NODE_ENV=development

# Configuração de Conexão com o PostgreSQL
DATABASE_URL="postgresql://usuario:senha@localhost:5432/projeto_banco?schema=public"
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=projeto_banco
DB_POOL_MAX=20
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECTION_TIMEOUT_MS=5000

# Parâmetros da Fila e Política de Retries
QUEUE_MAX_ATTEMPTS=3
QUEUE_BASE_BACKOFF_MS=1000
QUEUE_MAX_BACKOFF_MS=30000
